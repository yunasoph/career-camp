{
    "name": "careercampus/backend",
    "description": "CareerCampus API — PHP 8.3 + Slim 4 + PostgreSQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.0",
        "monolog/monolog": "^3.6",
        "php-di/php-di": "^7.0",
        "respect/validation": "^2.3",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.13",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.57",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.2"
    },
    "autoload": {
        "psr-4": {
            "CareerCampus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CareerCampus\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
