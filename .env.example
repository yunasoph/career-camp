# ------------------------------------------------------------------
# CareerCampus environment — copy to .env and adjust.
# Never commit real secrets (see spec.md §15.4).
# ------------------------------------------------------------------

# development | test | production
APP_ENV=development

# PostgreSQL 16 (inside the docker network the db host is "db")
DB_HOST=db
DB_PORT=5432
DB_NAME=careercampus
DB_USER=careercampus
DB_PASSWORD=careercampus

# Auth — HS256 secret for access tokens.
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# CORS — the only origin allowed to call the API with credentials.
FRONTEND_ORIGIN=http://localhost:5173
